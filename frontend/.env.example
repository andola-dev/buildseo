# ---------------------------------------------------------------------------
# BuildSEO frontend environment
#
# Only values that genuinely need to reach the browser may use NEXT_PUBLIC_.
# NEVER put backend secrets, provider API keys or signing keys in this file.
# ---------------------------------------------------------------------------

# FastAPI backend origin. The client appends /api/v1 itself.
#   development: http://localhost:8000
#   production:  https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Product name shown in the sidebar, header and page titles.
NEXT_PUBLIC_APP_NAME=BuildSEO

# Optional: request timeout in milliseconds for API calls.
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Tooling only (not exposed to the browser)
# ---------------------------------------------------------------------------

# Source of the OpenAPI schema for `npm run codegen:api`.
API_SCHEMA_URL=http://localhost:8000/openapi.json

# Base URL used by the Playwright E2E suite. When unset, E2E specs that need a
# live backend are skipped rather than mocked.
# E2E_BASE_URL=http://localhost:3000
