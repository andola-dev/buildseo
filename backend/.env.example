# ---------------------------------------------------------------------------
# BuildSEO backend configuration
#
# Copy to .env and replace every value marked CHANGE ME.
# .env is git-ignored and must never be committed.
#
# Generate the two secrets with:
#   JWT_SECRET:     openssl rand -base64 48
#   ENCRYPTION_KEY: openssl rand -base64 32     (must decode to exactly 32 bytes)
#
# The application refuses to start when APP_ENV is not local/test and either
# secret is still the placeholder below.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
APP_ENV=local                     # local | test | development | staging | production
APP_NAME=BuildSEO API
DEBUG=true                        # must be false outside local/test
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true                 # disable in production if the API is public

# --- database --------------------------------------------------------------
# Runtime role: NOSUPERUSER + NOBYPASSRLS, so Row-Level Security applies to it.
DATABASE_URL=postgresql+asyncpg://buildseo_app:buildseo_app@localhost:5432/buildseo
# Migration role: owns the schema. Superuser locally; omit to reuse DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql+asyncpg://buildseo:buildseo@localhost:5432/buildseo
# Name of the runtime role that privilege grants target.
DB_APP_ROLE=buildseo_app

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
DB_STATEMENT_TIMEOUT_MS=30000
DB_ECHO=false

# --- authentication --------------------------------------------------------
JWT_SECRET=dev-secret-not-for-production-use-only-0123456789   # CHANGE ME
JWT_ALGORITHM=HS256
JWT_ISSUER=buildseo
JWT_AUDIENCE=buildseo-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_LEEWAY_SECONDS=10

# --- passwords (Argon2id) --------------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LENGTH=32

# --- credential encryption (BYOK) ------------------------------------------
# base64 of exactly 32 random bytes. Losing this makes stored provider
# credentials unrecoverable; rotate by adding a version, never by overwriting.
ENCRYPTION_KEY=dGhpcy1pcy1hLWRldi1vbmx5LWtleS0zMi1ieXRlcyE=   # CHANGE ME
ENCRYPTION_KEY_VERSION=1

# --- HTTP ------------------------------------------------------------------
# Comma-separated, or a JSON array — both are accepted:
#   CORS_ORIGINS=http://localhost:3000,http://localhost:5173
#   CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Never "*" outside local/test. TRUSTED_HOSTS takes the same two forms.
# The dockerised frontend is published on FRONTEND_PORT (5175) below.
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
CORS_ALLOW_CREDENTIALS=true
# Empty disables the host check entirely. If you set it, include the compose
# service name "backend" as well as localhost: the frontend's /api/session/*
# route handlers call http://backend:8000 from inside the compose network, so
# a list of only localhost makes every proxied auth call fail with a bare 400
# "Invalid host header".
#   TRUSTED_HOSTS=localhost,127.0.0.1,backend
TRUSTED_HOSTS=
SECURE_HEADERS_ENABLED=true

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true
LOG_REQUEST_BODY=false            # must stay false outside local/test

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# --- outbound HTTP client --------------------------------------------------
HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_MAX_RETRIES=2
HTTP_MAX_RESPONSE_BYTES=5242880
HTTP_FOLLOW_REDIRECTS=true
HTTP_MAX_REDIRECTS=5
HTTP_USER_AGENT=BuildSEO/0.1 (+https://buildseo.example/bot)

# --- background worker -----------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=5
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_SECONDS=30
WORKER_JOB_TIMEOUT_SECONDS=300

# --- pagination ------------------------------------------------------------
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# --- business rules --------------------------------------------------------
# MVP: only FREE publishers may enter a submission workflow. Leave true.
FREE_ONLY_ENFORCED=true

# ---------------------------------------------------------------------------
# docker compose only (consumed by docker-compose.yml, not by the app)
# ---------------------------------------------------------------------------
POSTGRES_USER=buildseo
POSTGRES_PASSWORD=buildseo
POSTGRES_DB=buildseo
POSTGRES_PORT=5432
DB_APP_PASSWORD=buildseo_app
API_PORT=8000
FRONTEND_PORT=5175

# ---------------------------------------------------------------------------
# Provider API keys are NOT configured here.
# BuildSEO is bring-your-own-key: each tenant stores its own credentials
# through POST /api/v1/credentials, encrypted at rest with ENCRYPTION_KEY.
# There is deliberately no global provider key.
# ---------------------------------------------------------------------------
