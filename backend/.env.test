# ---------------------------------------------------------------------------
# Test database connection.
#
# Loaded automatically by tests/conftest.py — never picked up by the app
# itself, so it does not need every setting the real .env does. It only has
# to point tests/fixtures/database.py at a scratch database that isn't the
# development one, so a test run can never collide with dev data.
#
# The values below are the same defaults tests/fixtures/database.py already
# falls back to when these vars are unset; setting them explicitly here just
# removes the ambiguity so a test run can never silently target the wrong
# database. Override in your shell if your test database lives elsewhere.
# ---------------------------------------------------------------------------

TEST_DATABASE_URL=postgresql+asyncpg://buildseo:buildseo@localhost:5432/buildseo_test
TEST_APP_DATABASE_URL=postgresql+asyncpg://buildseo_app:buildseo_app@localhost:5432/buildseo_test
